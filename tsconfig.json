{
  "compilerOptions": {
    "allowJs": true,      // allow .js files
    "checkJs": false,     // optional, disable JS type checking
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
